{
  "name": "qoldau",
  "private": true,
  "version": "1.0.0",
  "author": "Ерланқызы Айшабибі",
  "contributors": [
    "Ерланқызы Айшабибі",
    "Берікқызы Ғайнижамал"
  ],
  "description": "Qoldau — ым тілін камера арқылы танып, қазақша мәтін мен дауысқа айналдыратын веб-қосымша",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "postinstall": "node scripts/setup-assets.mjs",
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"tsx watch server/index.ts\"",
    "dev:web": "vite",
    "dev:api": "tsx watch server/index.ts",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "docs:words": "tsx scripts/export-words.ts",
    "videos": "tsx scripts/compress-videos.ts",
    "landmarks": "tsx scripts/extract-landmarks.ts",
    "sign-model": "tsx scripts/build-sign-model.ts",
    "build:firebase": "tsc -b && vite build --mode firebase",
    "deploy": "npm run build:firebase && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@diffusionstudio/piper-wasm": "^1.0.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@mediapipe/tasks-vision": "^1.0.1",
    "@mintplex-labs/piper-tts-web": "^1.0.5",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "firebase": "^12.19.0",
    "idb-keyval": "^6.3.0",
    "onnxruntime-web": "^1.30.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.0.1"
  }
}
