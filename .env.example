# Qoldau server configuration. Copy to `.env` and fill in what you need.
# Everything is optional: without keys the app still works (local sentence
# builder + the browser's own speech synthesis).

# API server port (Vite proxies /api to it in development)
PORT=8787

# Behind a hosting proxy (Render, Railway, nginx…): trust 1 proxy hop.
# TRUST_PROXY=1

# --- Claude: turns recognised gesture words into a grammatical Kazakh sentence
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5

# --- Azure AI Speech: natural Kazakh voice (kk-KZ-AigulNeural / kk-KZ-DauletNeural)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
# AZURE_SPEECH_VOICE=kk-KZ-AigulNeural
